      "displayName": "构建 Release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug",
      "displayName": "构建 Debug"
    }
  ],
  "vendor": {
    "qt-project.org/Presets": {
      "checksum": "TXwmNxwYSLtXQEB+unaZ23U6fL4="
    }
  }
