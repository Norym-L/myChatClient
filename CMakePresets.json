{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-base",
      "hidden": true,
      "displayName": "Windows / MinGW (Qt 6.11.2)",
      "description": "CLion 打开本工程时选 mingw-debug 或 mingw-release。工具链必须配对：Qt 6.11.2/mingw_64 ←→ mingw1310_64 (GCC 13.1)，不可换用 GCC 11.2。",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/dev/Qt/6.11.2/mingw_64",
        "CMAKE_CXX_COMPILER": "C:/dev/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "C:/dev/Qt/Tools/mingw1310_64/bin/windres.exe",
        "CMAKE_MAKE_PROGRAM": "C:/dev/Qt/Tools/Ninja/ninja.exe"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "mingw-base",
      "displayName": "Release (MinGW GCC 13.1 + Qt 6.11.2)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-debug",
      "inherits": "mingw-base",
      "displayName": "Debug (MinGW GCC 13.1 + Qt 6.11.2)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "displayName": "Windows / MSVC (Qt 6.11.2, VS 2026)",
      "description": "用 Visual Studio 18 2026 生成器（多配置，构建时再选 Debug/Release）。⚠ 该生成器自 CMake 4.2 起提供，本机 CMake 必须 ≥ 4.2。工具链由 vswhere 自动发现，工具集默认 v145（MSVC 14.51）。Qt 侧用 msvc2022_64 包：Qt 6.11.2 尚未发布 msvc2026_64，而 MSVC 14.4x(VS2022) 与 14.5x(VS2026) 二进制兼容，可正常链接；该包自带调试版库（Qt6Cored.dll 等），Debug 能单步进 Qt 源码。将来 Qt 装了 msvc2026_64 就把 CMAKE_PREFIX_PATH 改过去；没装 VS 2026 则把 generator 改回 \"Visual Studio 17 2022\"。",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/dev/Qt/6.11.2/msvc2022_64"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-base",
      "displayName": "Release (MSVC 2026 + Qt 6.11.2)"
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-base",
      "displayName": "Debug (MSVC 2026 + Qt 6.11.2)"
    },
    {
      "hidden": true,
      "name": "Qt",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      },
      "vendor": {
        "qt-project.org/Qt": {
          "checksum": "wVa86FgEkvdCTVp1/nxvrkaemJc="
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release",
      "displayName": "构建 Release"
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "displayName": "构建 Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
