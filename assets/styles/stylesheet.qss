QDialog#LoginDialog
{
    background-color: rgb(23,21,22)
}

#err_tip[state='normal']
{
    color: green;
}

#err_tip[state='err']
{
    color: red;
}

#error_tip[state='normal']
{
    color: green;
}

#error_tip[state='err']
{
    color: red;
}

#forget_label[state="normal"]
{
    color: white;
}

#forget_label[state="hover"]
{
    color: blue;
}

#pass_visible[state='unvisible']
{
   border-image: url(:/res/unvisible.png);
}

#pass_visible[state='unvisible_hover']
{
   border-image: url(:/res/unvisible_hover.png);
}

#pass_visible[state='visible']
{
   border-image: url(:/res/visible.png);
}

#pass_visible[state='visible_hover']
{
   border-image: url(:/res/visible_hover.png);
}


#pass2_visible[state='unvisible']
{
   border-image: url(:/res/unvisible.png);
}

#pass2_visible[state='unvisible_hover']
{
   border-image: url(:/res/unvisible_hover.png);
}

#pass2_visible[state='visible']
{
   border-image: url(:/res/visible.png);
}

#pass2_visible[state='visible_hover']
{
   border-image: url(:/res/visible_hover.png);
}

#side_bar
{
    background-color: rgb(34, 34, 34);
}

#add_button[state='normal']
{
    border-image: url(:/res/add-user.png);
}

#add_button[state='hover']
{
    border-image: url(:/res/add-user_hover.png);
}

#add_button[state='press']
{
    border-image: url(:/res/add-user_push.png);
}

#search_widget
{
    background-color: rgb(34, 34, 34);
}

#serach_edit
{
    background-color: rgb(47, 47, 47);
    border: 1px solid rgb(47, 47, 47);
}

#chat_user_widget
{
    background-color: rgb(34, 34, 34);
}

#chat_users_list
{
    background-color: rgb(34, 34, 34);
    border: none;
    outline: none;
}

#chat_users_list::item:selected
{
    background-color: rgb(61, 61, 61);
    border: none;
    outline: none;
}

#chat_users_list::item:selected:hover
{
    background-color: rgb(61, 61, 61);
    border: none;
    outline: none;
}

#chat_users_list::item:hover
{
    background-color: rgb(51, 51, 51);
    border: none;
    outline: none;
}