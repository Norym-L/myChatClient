/* ============================================================
   会话聊天页 InterChatPage（chat/chatPage/interchatpage.qss）
   作为 chatpage.qss 中 stackedWidget 的 chat_page 页实例化。
   全局基础见 ../../../common.qss
   ============================================================ */

/* 标题 */
QLabel#title_label
{
    color: white;
    font-size: 16px;
    font-weight: 600;
    padding-left: 8px;
}

/* 消息展示区 */
QScrollArea#chat_area
{
    background-color: rgb(34, 34, 34);
    border-top: 1px solid rgb(47, 47, 47);
    border-bottom: 1px solid rgb(47, 47, 47);
}

QWidget#null_widget,
QWidget#widget,
QWidget#scrollAreaWidgetContents
{
    border: none;
    background-color: rgb(34, 34, 34);
}

/* 工具栏 / 按钮区：透明容器，沿用页面主背景
   注：button_widget 已改为悬浮在 chat_edit 右下角（见 interchatpage.cpp） */
QWidget#tool_widget,
QWidget#button_widget
{
    background-color: transparent;
}

/* 消息输入框：与搜索框同一套控件底色，保证边界可见 */
QTextEdit#chat_edit
{
    background-color: rgb(34, 34, 34);
    border: none;
    color: white;
    font-size: 14px;
    /* 底部留白 = 按钮区高度 40 + 边距 8，避免文字被悬浮按钮遮挡 */
    padding: 6px 8px 68px 8px;
    selection-color: white;
}

/* 发送：QQ 蓝主按钮 */
QPushButton#send_button
{
    background-color: rgb(0,153,255);
    color: white;
}

QPushButton#send_button:hover
{
    background-color: rgb(26,168,255);
}

QPushButton#send_button:pressed
{
    background-color: rgb(0,122,204);
}

QPushButton#send_button:disabled
{
    background-color: rgba(0,153,255,90);
    color: rgba(255,255,255,150);
}

/* 接收(debug)：次级按钮 */
QPushButton#receive_button
{
    background-color: rgb(47,47,47);
    color: rgb(220,220,220);
}

QPushButton#receive_button:hover
{
    background-color: rgb(61,61,61);
}

QPushButton#receive_button:pressed
{
    background-color: rgb(51,51,51);
}

/* 表情按钮 */
QLabel#emoji_label[state='normal']
{
    border-image: url(:/res/grinning-face.png);
}

QLabel#emoji_label[state='hover']
{
    border-image: url(:/res/grinning-face_hover.png);
}

QLabel#emoji_label[state='press']
{
    border-image: url(:/res/grinning-face_push.png);
}

/* 文件按钮 */
QLabel#file_label[state='normal']
{
    border-image: url(:/res/file.png);
}

QLabel#file_label[state='hover']
{
    border-image: url(:/res/file_hover.png);
}

QLabel#file_label[state='press']
{
    border-image: url(:/res/file_push.png);
}