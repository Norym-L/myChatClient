/* ============================================================
   聊天主页 ChatPageClass（chat/chatpage.qss）
   ------------------------------------------------------------
   聊天页结构（选择器据此编写，控件改名后需同步）：
     ChatPageClass
       ├─ side_bar            （side_chat_label / side_contact_label）
       ├─ chat_user_widget    （search_widget / search_edit / add_button）
       │                       chat_users_list / search_list / con_user_list
       └─ stackedWidget
            ├─ chat_page      （InterChatPage：见 chatPage/interchatpage.qss）
            └─ friend_info_page
   全局基础见 ../common.qss
   ============================================================ */

/* 聊天主页面（作为 MainWindow 的中央部件） */
QWidget#ChatPageClass
{
    background-color: rgb(23,21,22);
    color: white;
}

/* ---- 左侧功能栏 ---- */

QWidget#side_bar
{
    background-color: rgb(34,34,34);
    border-right: 1px solid rgb(47, 47, 47);
}

/* ---- 会话列表区 ---- */

QWidget#chat_user_widget
{
    background-color: rgb(34,34,34);
    border-right: 1px solid rgb(15,14,14);
}

/* 搜索区容器（.ui 中已修正为 search_widget） */
QWidget#search_widget
{
    background-color: rgb(34,34,34);
}

/* 添加好友按钮（图标按钮，border-image 三态） */
QPushButton#add_button
{
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
}

QPushButton#add_button[state='normal']
{
    border-image: url(:/res/add-user.png);
}

QPushButton#add_button[state='hover']
{
    border-image: url(:/res/add-user_hover.png);
}

QPushButton#add_button[state='press']
{
    border-image: url(:/res/add-user_push.png);
}

/* ---- 三个列表：会话 / 搜索 / 联系人 统一风格 ---- */

QListWidget#chat_users_list,
QListWidget#search_list,
QListWidget#con_user_list
{
    background-color: rgb(34,34,34);
    border: none;
    outline: none;
}

QListWidget#chat_users_list::item,
QListWidget#search_list::item,
QListWidget#con_user_list::item
{
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#chat_users_list::item:hover,
QListWidget#search_list::item:hover,
QListWidget#con_user_list::item:hover
{
    background-color: rgb(51,51,51);
}

QListWidget#chat_users_list::item:selected,
QListWidget#search_list::item:selected,
QListWidget#con_user_list::item:selected
{
    background-color: rgb(61,61,61);
    border: none;
    outline: none;
}

QListWidget#chat_users_list::item:selected:hover,
QListWidget#search_list::item:selected:hover,
QListWidget#con_user_list::item:selected:hover
{
    background-color: rgb(61,61,61);
    border: none;
    outline: none;
}

/* ---- 右侧内容区：QStackedWidget 翻页容器 ---- */

/* 容器本身给主背景，避免翻页瞬间露出默认底色
   注意：注册页存在同名容器 stackedWidget，本规则同样命中（与拆分前行为一致） */
QStackedWidget#stackedWidget
{
    background-color: rgb(34, 34, 34);
    border-left: 1px solid rgb(47, 47, 47);
}

/* 聊天页（InterChatPage 实例）与好友信息页：统一主背景 */
QWidget#chat_page,
QWidget#friend_info_page
{
    background-color: rgb(34, 34, 34);
    color: white;
}
