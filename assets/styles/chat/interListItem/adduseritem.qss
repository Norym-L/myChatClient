/* 作为 item widget 嵌入会话列表，背景透明以透出列表的选择/悬停高亮 */
QWidget#AddUserItem
{
    background-color: transparent;
}

QWidget#AddUserItem QLabel#message_tip
{
    color: white;
    font-size: 14px;
}

QWidget#AddUserItem QWidget#invalid_item
{
    border: none;
    background-color: rgb(34, 34, 34);
}

QWidget#AddUserItem QLabel#add_tip
{
    border-image: url(":/assets/images/addUser.png");
}

QWidget#AddUserItem QLabel#right_tip
{
    border-image: url(":/assets/images/right_hover.png");
}