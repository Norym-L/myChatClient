/* ============================================================
   MyChat —— 结构层样式（common.qss）
   ------------------------------------------------------------
   职责：只放「与主题无关」的规则 —— 尺寸、圆角、内边距、字号、
        透明背景、border:none 复位。**不允许出现任何颜色值**
        （transparent 除外），全部颜色与图标在主题层：
          themes/dark.qss   深色主题（QQ NT 蓝黑系）
          themes/light.qss  浅色主题（QQ NT 浅色系）
        两个主题文件的选择器一一对应，加载时本文件在前、主题在后。

   加载入口：global.cpp 的 applyTheme()。
   新增控件样式时：几何/字体进本文件，颜色/图标同时进两个主题文件。
   ============================================================ */

/* ==================== 全局基础 ==================== */

QDialog
{
    font-size: 14px;
}

/* 提示气泡 */
QToolTip
{
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    padding: 4px 8px;
}

/* 菜单（输入框右键菜单等） */
QMenu
{
    border-width: 1px;
    border-style: solid;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item
{
    border-radius: 4px;
    padding: 6px 24px;
    background-color: transparent;
}

QMenu::separator
{
    height: 1px;
    margin: 4px 8px;
}

/* ---- 滚动条（悬浮式：无轨道，仅滑块） ----
   滑块宽度需与 chatpage.cpp 的滚动条宽度常量保持一致（8px） */

QScrollBar:vertical
{
    background: transparent;
    border: none;
    width: 8px;
    margin: 0px;
    padding: 0px;
}
QScrollBar::handle:vertical
{
    border: none;
    border-radius: 3px;
    min-height: 30px;
    margin: 0px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical
{
    background: transparent;
    border: none;
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical
{
    background: transparent;
    border: none;
}

QScrollBar:horizontal
{
    background: transparent;
    border: none;
    height: 8px;
    margin: 0px;
    padding: 0px;
}
QScrollBar::handle:horizontal
{
    border: none;
    border-radius: 3px;
    min-width: 30px;
    margin: 2px 0px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal
{
    background: transparent;
    border: none;
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
    background: transparent;
    border: none;
}
QScrollBar::corner
{
    background: transparent;
    border: none;
}

/* ---- 输入框（登录/注册/重置表单 + 搜索框统一套用） ---- */

QLineEdit
{
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    padding: 2px 8px;
}

/* ---- 按钮基础 ---- */

QPushButton
{
    border: none;
    border-radius: 6px;
    padding: 5px 16px;
    font-size: 14px;
}

/* ==================== 登录 / 注册 / 重置 ==================== */

/* 登录按钮更宽的内边距（QQ 登录窗主按钮形态） */
QPushButton#login_button
{
    padding: 5px 40px;
}

/* 获取验证码按钮（TimerButton）：描边按钮形态 */
QPushButton#get_token_button,
QPushButton#get_verify_button
{
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    padding: 2px 10px;
}

/* ==================== 聊天主页 ChatPage ==================== */

/* 三个列表：会话 / 搜索 / 联系人 —— 去掉默认边框与焦点框 */
QListWidget#chat_users_list,
QListWidget#search_list,
QListWidget#con_user_list,
QListWidget#friend_apply_list
{
    border: none;
    outline: none;
}

QListWidget#chat_users_list::item,
QListWidget#search_list::item,
QListWidget#con_user_list::item,
QListWidget#friend_apply_list::item
{
    border: none;
    outline: none;
}

/* 添加好友按钮（纯图标按钮，由主题层给 border-image） */
QPushButton#add_button
{
    border: none;
    border-radius: 0px;
    padding: 0px;
}

/* 右侧 QStackedWidget 翻页容器 */
QStackedWidget#stackedWidget
{
    padding-left: 1px;
}

/* ==================== 会话页 InterChatPage ==================== */

QLabel#title_label
{
    font-size: 16px;
    font-weight: 600;
    padding-left: 8px;
}

/* 工具栏 / 悬浮按钮区：透明容器 */
QWidget#tool_widget,
QWidget#button_widget
{
    background-color: transparent;
}

/* 消息输入框：底部留白 = 按钮区高度 40 + 边距，避免文字被悬浮按钮遮挡 */
QTextEdit#chat_edit
{
    border: none;
    font-size: 14px;
    padding: 6px 8px 68px 8px;
}

/* 聊天气泡内的名字 */
QLabel#name
{
    font-size: 13px;
}

/* ==================== 列表项组件 ==================== */

/* 作为 item widget 嵌入列表，背景透明以透出列表的悬停/选中高亮 */
QWidget#FriendWidget,
QWidget#AddUserItem,
QWidget#ContactUserItemClass,
QWidget#newFriendItem,
QWidget#ApplyFriendItemClass,
QWidget#GroupTipItemClass
{
    background-color: transparent;
}

QWidget#FriendWidget QLabel#user_name
{
    font-size: 14px;
}

QWidget#FriendWidget QLabel#time
{
    font-size: 11px;
}

QWidget#FriendWidget QLabel#user_chat
{
    font-size: 12px;
}

QWidget#AddUserItem QLabel#message_tip
{
    font-size: 14px;
}

QWidget#ContactUserItemClass QLabel#user_name,
QWidget#newFriendItem QLabel#user_name,
QWidget#ApplyFriendItemClass QLabel#user_name
{
    font-size: 14px;
}

QWidget#ContactUserItemClass QLabel#user_info,
QWidget#newFriendItem QLabel#user_info,
QWidget#ApplyFriendItemClass QLabel#user_info
{
    font-size: 12px;
}

/* 分组标题（联系人列表「联系人」等） */
QWidget#GroupTipItemClass QLabel#label
{
    font-size: 12px;
}

/* 好友申请页标题栏 */
QWidget#friend_apply_page QLabel#friend_apply_label
{
    font-size: 15px;
    font-weight: 600;
}

/* ==================== 搜索结果弹窗 FindResultDialog ==================== */

QDialog#FindResultDialog
{
    border-width: 1px;
    border-style: solid;
    border-radius: 8px;
}

/* 两行内容容器（必须带 QDialog#FindResultDialog 前缀，防止误命中
   interchatpage 的同名容器） */
QDialog#FindResultDialog QWidget#widget,
QDialog#FindResultDialog QWidget#widget_2
{
    background-color: transparent;
    border: none;
}

QLabel#name_label
{
    font-size: 14px;
    padding-left: 8px;
}

QPushButton#add_friend_button
{
    border: none;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 14px;
}

/* ==================== 加载中弹窗 LoadingDialog ==================== */

QDialog#LoadingDialog
{
    border-width: 1px;
    border-style: solid;
    border-radius: 8px;
}

QDialog#LoadingDialog QLabel#loading_label
{
    background-color: transparent;
    border: none;
}

/* ==================== 添加好友对话框 ApplyFriend ====================
   圆角 8px 必须与 ApplyFriend.cpp 的 kWindowCornerRadius 一致：
   QSS 画圆角底色 + 代码 setMask 切窗角，两件配套，改一必改二。 */

QDialog#ApplyFriend
{
    border-width: 1px;
    border-style: solid;
    border-radius: 8px;
}

/* 滚动区整片透明，露出弹窗自己的圆角底色。
   注意：QScrollArea 刷不到 viewport，必须用 > QWidget 子选择器 */
QDialog#ApplyFriend QScrollArea#scrollArea,
QDialog#ApplyFriend QScrollArea#scrollArea > QWidget,
QDialog#ApplyFriend QScrollArea#scrollArea > QWidget > QWidget,
QDialog#ApplyFriend QWidget#scrollcontents
{
    background-color: transparent;
    border: none;
}

QDialog#ApplyFriend QLabel#apply_label
{
    background-color: transparent;
    border: none;
    font-size: 16px;
    font-weight: bold;
}

/* 分隔线（.ui 里 class="Line" 即 QFrame） */
QDialog#ApplyFriend QFrame#line
{
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* 表单字段名 */
QDialog#ApplyFriend QLabel#label,
QDialog#ApplyFriend QLabel#label_2,
QDialog#ApplyFriend QLabel#label_3
{
    background-color: transparent;
    border: none;
    font-size: 13px;
    padding-top: 6px;
}

QDialog#ApplyFriend QLineEdit#verify_info_edit,
QDialog#ApplyFriend QLineEdit#back_name_edit
{
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    font-size: 14px;
    padding: 2px 8px;
}

/* 标签容器（grid 内标签由代码手工定位，不能给 border，会 inset 错位） */
QDialog#ApplyFriend QWidget#grid
{
    border: none;
    border-radius: 4px;
}

QDialog#ApplyFriend QWidget#friend_group_widget,
QDialog#ApplyFriend QWidget#widget,
QDialog#ApplyFriend QWidget#widget_2,
QDialog#ApplyFriend QWidget#label_list,
QDialog#ApplyFriend QWidget#more_label_widget,
QDialog#ApplyFriend QWidget#input_tip,
QDialog#ApplyFriend QWidget#apply_sure_widget
{
    background-color: transparent;
    border: none;
}

/* 标签输入框：无边框混排在标签行内（代码 move() 手工排布） */
QDialog#ApplyFriend QLineEdit#label_edit
{
    background-color: transparent;
    border: none;
    font-size: 14px;
    padding: 0px 2px;
}

/* 推荐标签胶囊（对象名两处：tipslb / tipsLabel） */
QLabel#tipslb,
QLabel#tipsLabel
{
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    font-size: 14px;
    padding: 3px 10px;
}

/* 「添加+xx」下拉提示 */
QDialog#ApplyFriend QLabel#tip_label
{
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
    font-size: 14px;
    padding: 3px 10px;
}

QDialog#ApplyFriend QLabel#more_label
{
    background-color: transparent;
    border: none;
    font-size: 13px;
}

QDialog#ApplyFriend QPushButton#sure_button,
QDialog#ApplyFriend QPushButton#cancel_button
{
    border: none;
    border-radius: 6px;
    font-size: 14px;
}

/* 提交等待时的 GIF 占位（界面补上 loading_label 后生效） */
QDialog#ApplyFriend QLabel#loading_label
{
    border: none;
    background-repeat: no-repeat;
    background-position: center;
    min-height: 120px;
}

/* ==================== 好友标签胶囊 FriendLabel ====================
   ★ 运行时根控件名是 "friendLabel"（ApplyFriend.cpp 覆盖），不是 FriendLabelClass。
   描边 1px 计入 FriendLabel.cpp 的 setFixedWidth(+14)，改宽必须同步改代码。 */

QFrame#friendLabel
{
    border-width: 1px;
    border-style: solid;
    border-radius: 4px;
}

QFrame#friendLabel QLabel#tip_label
{
    background-color: transparent;
    border: none;
    font-size: 14px;
    /* 兜底裁切：超长省略号需代码 elide，当前输入侧 setMaxLength(10) 不会触发 */
    max-width: 160px;
}

/* 关闭按钮热区容器（裸 QWidget 不收 hover，高亮挂在 close_label 上） */
QFrame#friendLabel QWidget#close_widget
{
    background-color: transparent;
    border: none;
}

/* 关闭图标：background-image 居中，源图 32x32 缩到 16x16 显示。
   state 取值两族：normal/hover/pressed 与 selected_normal/selected_hover/
   selected_pressed（ClickedLabel 点击后在 NORMAL/SELECT 间切换），两族都写。 */
QFrame#friendLabel QLabel#close_label
{
    background-color: transparent;
    background-repeat: no-repeat;
    background-position: center;
    border: none;
}
