/* ============================================================
   登录页 LoginDialog（login/logindialog.qss）
   全局基础与跨页复用件（error_tip 等）见 ../common.qss
   ============================================================ */

/* 忘记密码（可点击标签） */
QLabel#forget_label[state='normal']
{
    color: white;
}

QLabel#forget_label[state='hover']
{
    color: rgb(0,153,255);
}

/* 注册按钮：QQ 登录窗风格的蓝色文字链 */
QPushButton#register_button
{
    background-color: transparent;
    color: rgb(0,153,255);
}

QPushButton#register_button:hover
{
    background-color: rgb(51,51,51);
}

QPushButton#register_button:pressed
{
    background-color: rgb(61,61,61);
}

/* 登录按钮：QQ 蓝主按钮 */
QPushButton#login_button
{
    background-color: rgb(0,153,255);
    color: white;
    padding: 5px 40px;
}

QPushButton#login_button:hover
{
    background-color: rgb(26,168,255);
}

QPushButton#login_button:pressed
{
    background-color: rgb(0,122,204);
}

QPushButton#login_button:disabled
{
    background-color: rgba(0,153,255,90);
    color: rgba(255,255,255,150);
}
