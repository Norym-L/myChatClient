    background-color: transparent;
    border-color: rgb(0,153,255);
    color: rgb(0,153,255);
}

QPushButton#get_token_button:hover
{
    background-color: rgba(0,153,255,38);
}

QPushButton#get_token_button:pressed
{
    background-color: rgba(0,153,255,70);
}

QPushButton#get_token_button:disabled
{
    background-color: transparent;
    border-color: rgb(66,66,66);
    color: rgb(105,105,105);
}

/* 确认：QQ 蓝主按钮 */
QPushButton#confirm_button
{
    background-color: rgb(0,153,255);
    color: white;
}

QPushButton#confirm_button:hover
{
    background-color: rgb(38,166,255);
}

QPushButton#confirm_button:pressed
{
    background-color: rgb(0,122,204);
}

QPushButton#confirm_button:disabled
{
    background-color: rgba(0,153,255,80);
    color: rgba(255,255,255,130);
}

/* 注册成功页 */
