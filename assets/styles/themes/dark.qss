/* ============================================================
   MyChat —— 深色主题（themes/dark.qss，QQ NT 深色：中性炭灰）
   ------------------------------------------------------------
   色板（本文件唯一权威来源，选择器与 light.qss 一一对应）：

   背景色阶（中性灰，逐级提亮，蓝色只作强调不进背景）：
   - 窗口背景    rgb(24,24,24)   登录/注册/重置对话框、主窗口
   - 侧栏背景    rgb(28,28,28)   side_bar（全窗最深一档）
   - 面板背景    rgb(34,34,34)   会话/搜索/联系人列表区
   - 聊天区背景  rgb(43,43,43)   右区（消息区 / 输入区 / 标题栏 / 申请页）
   - 卡片背景    rgb(44,44,44)   浮层弹窗（FindResult/ApplyFriend/Loading）
   - 控件背景    rgb(52,52,52)   输入框 / 次级按钮 / 标签区
   - 悬停        rgb(58,58,58)   也用作对方气泡
   - 选中        rgb(66,66,66)   列表选中 / 胶囊底色
   - 描边强调    rgb(90,90,90)   胶囊描边 / 滚动条滑块悬停

   边框：
   - 分隔线      rgb(52,52,52)   面板间 1px 分隔线、输入框默认描边
   - 强描边      rgb(72,72,72)   浮层卡片边框、输入框悬停

   文字：
   - 主文字      rgb(235,235,235)  对比度（对面板）≈ 12.6:1
   - 次级文字    rgb(150,150,150)  ≈ 5.9:1（AA）
   - 禁用文字    rgb(105,105,105)

   强调（QQ 蓝，只用于主按钮 / 焦点 / 链接态，不进背景）：
   - 强调        rgb(0,153,255)
   - 强调-悬停   rgb(38,166,255)
   - 强调-按下   rgb(0,122,204)
   - 强调-淡底   rgba(0,153,255,38) / rgba(0,153,255,70)   描边按钮悬停/按下
   - 强调-禁用   rgba(0,153,255,80) + 字 rgba(255,255,255,130)

   功能色：
   - 错误        rgb(240,100,100)
   - 成功        rgb(80,200,140)

   气泡（QQ NT 深色为中性灰气泡，蓝色只留给发送按钮等强调件）：
   - 自己        rgb(70,70,70)（白字）
   - 对方        rgb(56,56,56)（主文字）

   结构（圆角/尺寸/字体）见 ../common.qss。
   ============================================================ */

/* ==================== 全局基础 ==================== */

QDialog
{
    background-color: rgb(24,24,24);
    color: rgb(235,235,235);
}

QMainWindow
{
    background-color: rgb(24,24,24);
    color: rgb(235,235,235);
}

QToolTip
{
    background-color: rgb(52,52,52);
    color: rgb(235,235,235);
    border-color: rgb(72,72,72);
}

/* 菜单（输入框右键菜单等） */
QMenu
{
    background-color: rgb(44,44,44);
    color: rgb(235,235,235);
    border-color: rgb(72,72,72);
}

QMenu::item:selected
{
    background-color: rgb(58,58,58);
}

QMenu::item:disabled
{
    color: rgb(105,105,105);
}

QMenu::separator
{
    background-color: rgb(52,52,52);
}

/* ---- 滚动条滑块 ---- */

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal
{
    background: rgb(66,66,66);
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed
{
    background: rgb(90,90,90);
}

/* ---- 输入框 ---- */

QLineEdit
{
    background-color: rgb(52,52,52);
    border-color: rgb(52,52,52);
    color: rgb(235,235,235);
    selection-background-color: rgb(0,153,255);
    selection-color: white;
}

QLineEdit:hover
{
    border-color: rgb(72,72,72);
}

QLineEdit:focus
{
    border-color: rgb(0,153,255);
}

QLineEdit:disabled
{
    background-color: rgb(44,44,44);
    border-color: rgb(44,44,44);
    color: rgb(105,105,105);
}

/* ---- 按钮基础 ---- */

QPushButton
{
    background-color: rgb(52,52,52);
    color: rgb(235,235,235);
}

QPushButton:hover
{
    background-color: rgb(58,58,58);
}

QPushButton:pressed
{
    background-color: rgb(66,66,66);
}

QPushButton:disabled
{
    background-color: rgb(44,44,44);
    color: rgb(105,105,105);
}

/* ==================== 跨页面复用 ==================== */

/* 错误/成功提示（state 由代码设置 + repolish 刷新） */
QLabel#error_tip[state='normal'],
QLabel#err_tip[state='normal']
{
    color: rgb(80,200,140);
}

QLabel#error_tip[state='err'],
QLabel#err_tip[state='err']
{
    color: rgb(240,100,100);
}

/* 取消按钮：次级按钮（注册页、重置页共用） */
QPushButton#cancel_button
{
    background-color: rgb(52,52,52);
    color: rgb(215,215,215);
}

QPushButton#cancel_button:hover
{
    background-color: rgb(66,66,66);
}

QPushButton#cancel_button:pressed
{
    background-color: rgb(58,58,58);
}

/* ==================== 登录页 ==================== */

/* 忘记密码（ClickedLabel，state 属性驱动） */
QLabel#forget_label[state='normal']
{
    color: rgb(235,235,235);
}

QLabel#forget_label[state='hover']
{
    color: rgb(0,153,255);
}

/* 注册按钮：蓝色文字链 */
QPushButton#register_button
{
    background-color: transparent;
    color: rgb(0,153,255);
}

QPushButton#register_button:hover
{
    background-color: rgb(58,58,58);
}

QPushButton#register_button:pressed
{
    background-color: rgb(66,66,66);
}

/* 登录按钮：QQ 蓝主按钮 */
QPushButton#login_button
{
    background-color: rgb(0,153,255);
    color: white;
}

QPushButton#login_button:hover
{
    background-color: rgb(38,166,255);
}

QPushButton#login_button:pressed
{
    background-color: rgb(0,122,204);
}

QPushButton#login_button:disabled
{
    background-color: rgba(0,153,255,80);
    color: rgba(255,255,255,130);
}

/* ==================== 注册页 ==================== */

/* 密码可见性图标。
   ★ state 取值以 registerdialog.cpp 的 setState() 实参为准：
     invisible / invisible_hover / visible / visible_hover。
   ★ 图标为深色主题补丁变体（原图 68 灰在控件底色上对比度不足），
     hover 青色双主题通用。 */
QLabel#pass_visible[state='invisible'],
QLabel#pass2_visible[state='invisible']
{
    border-image: url(:/assets/images/themes/dark/invisible.png);
}

QLabel#pass_visible[state='invisible_hover'],
QLabel#pass2_visible[state='invisible_hover']
{
    border-image: url(:/res/invisible_hover.png);
}

QLabel#pass_visible[state='visible'],
QLabel#pass2_visible[state='visible']
{
    border-image: url(:/assets/images/themes/dark/visible.png);
}

QLabel#pass_visible[state='visible_hover'],
QLabel#pass2_visible[state='visible_hover']
{
    border-image: url(:/res/visible_hover.png);
}

/* 获取验证码：蓝描边按钮（TimerButton 倒计时期间 disabled） */
QPushButton#get_token_button
