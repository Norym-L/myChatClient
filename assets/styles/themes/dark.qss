}

/* ---- 右侧内容区（聊天区：比列表区亮一档，与 QQ NT 一致） ---- */

/* 注意：注册页存在同名 stackedWidget，本规则同样命中（与拆分前行为一致） */
QStackedWidget#stackedWidget
{
    background-color: rgb(43,43,43);
    border-left: 1px solid rgb(52,52,52);
}

QWidget#chat_page,
QWidget#friend_info_page,
QWidget#friend_apply_page
{
    background-color: rgb(43,43,43);
    color: rgb(235,235,235);
}

/* ==================== 会话页 InterChatPage ==================== */

QLabel#title_label
{
    color: rgb(235,235,235);
}

/* 消息展示区（作用域锚点 #chat_page 是运行时真实祖先，类名锚点永不匹配，
   提升控件的 objectName 会被 uic 覆盖） */
QWidget#chat_page QScrollArea#chat_area
{
    background-color: rgb(43,43,43);
    border-top: 1px solid rgb(52,52,52);
    border-bottom: 1px solid rgb(52,52,52);
}

/* ChatView 内部容器（必须带 #chat_page 前缀，裸选择器会全局误命中
   login/register/reset/chatpage 的同名容器） */
QWidget#chat_page QWidget#widget,
QWidget#chat_page QWidget#null_widget,
QWidget#chat_page QWidget#scrollAreaWidgetContents,
QWidget#chat_page QWidget#widget_4
{
    border: none;
    background-color: rgb(43,43,43);
}

/* 消息输入框：与聊天区同色，靠 chat_area 的下边框分隔 */
QTextEdit#chat_edit
{
    background-color: rgb(43,43,43);
    color: rgb(235,235,235);
    selection-background-color: rgb(0,153,255);
    selection-color: white;
}

/* 发送：QQ 蓝主按钮 */
QPushButton#send_button
{
    background-color: rgb(0,153,255);
    color: white;
}

QPushButton#send_button:hover
{
    background-color: rgb(38,166,255);
}

QPushButton#send_button:pressed
{
    background-color: rgb(0,122,204);
}

QPushButton#send_button:disabled
{
    background-color: rgba(0,153,255,80);
    color: rgba(255,255,255,130);
}

/* 接收(debug)：次级按钮 */
QPushButton#receive_button
{
    background-color: rgb(52,52,52);
    color: rgb(215,215,215);
}

QPushButton#receive_button:hover
{
    background-color: rgb(66,66,66);
}

QPushButton#receive_button:pressed
{
    background-color: rgb(58,58,58);
}

/* 表情按钮 */
QLabel#emoji_label[state='normal']
{
    border-image: url(:/res/grinning-face.png);
}

QLabel#emoji_label[state='hover']
{
    border-image: url(:/res/grinning-face_hover.png);
}

QLabel#emoji_label[state='press']
{
    border-image: url(:/res/grinning-face_push.png);
}

/* 文件按钮 */
QLabel#file_label[state='normal']
{
    border-image: url(:/res/file.png);
}

QLabel#file_label[state='hover']
{
    border-image: url(:/res/file_hover.png);
}

QLabel#file_label[state='press']
{
    border-image: url(:/res/file_push.png);
}

/* 气泡旁的名字 */
QLabel#name
{
    color: rgb(150,150,150);
}

/* ---- 气泡（BubbleFrame 自绘，颜色经 qproperty 注入；
   QQ NT 深色为中性灰气泡） ---- */

BubbleFrame
{
    qproperty-bubbleColorSelf: rgb(70,70,70);
    qproperty-bubbleColorOther: rgb(56,56,56);
}

/* 气泡内文字（TextBubble 内嵌只读 QTextEdit；bubbleRole 属性由
   BubbleFrame 构造时按角色写入） */
TextBubble[bubbleRole='self'] QTextEdit
{
    color: white;
    background: transparent;
    border: none;
}

TextBubble[bubbleRole='other'] QTextEdit
{
    color: rgb(235,235,235);
    background: transparent;
    border: none;
}

