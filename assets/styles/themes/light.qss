/* ---- 气泡 ---- */

BubbleFrame
{
    qproperty-bubbleColorSelf: rgb(0,153,255);
    qproperty-bubbleColorOther: rgb(255,255,255);
}

TextBubble[bubbleRole='self'] QTextEdit
{
    color: white;
    background: transparent;
    border: none;
}

TextBubble[bubbleRole='other'] QTextEdit
{
    color: rgb(28,31,36);
    background: transparent;
    border: none;
}

