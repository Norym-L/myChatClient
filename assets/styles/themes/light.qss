}

QLabel#tipslb[state='selected_normal'],
QLabel#tipsLabel[state='selected_normal']
{
    background-color: rgb(240,241,244);
    border-color: rgb(0,153,255);
    color: rgb(28,31,36);
}

QLabel#tipslb[state='selected_hover'],
QLabel#tipsLabel[state='selected_hover']
{
    background-color: rgb(216,219,225);
    border-color: rgb(0,153,255);
    color: rgb(28,31,36);
}

QLabel#tipslb[state='selected_pressed'],
QLabel#tipsLabel[state='selected_pressed']
{
    background-color: rgb(228,230,234);
    border-color: rgb(0,153,255);
    color: rgb(28,31,36);
}

QDialog#ApplyFriend QLabel#tip_label
{
    background-color: rgb(216,219,225);
    border-color: rgb(0,153,255);
    color: rgb(28,31,36);
}

QDialog#ApplyFriend QLabel#more_label
{
    color: rgb(122,129,139);
}

QDialog#ApplyFriend QLabel#more_label:hover
{
    color: rgb(28,31,36);
}

QDialog#ApplyFriend QPushButton#sure_button
{
    background-color: rgb(0,153,255);
    color: white;
}

QDialog#ApplyFriend QPushButton#sure_button:hover
{
    background-color: rgb(38,166,255);
}

QDialog#ApplyFriend QPushButton#sure_button:pressed
{
    background-color: rgb(0,122,204);
}

QDialog#ApplyFriend QPushButton#sure_button:disabled
{
    background-color: rgba(0,153,255,90);
    color: rgba(255,255,255,190);
}

QDialog#ApplyFriend QPushButton#cancel_button
{
    background-color: rgb(240,241,244);
    color: rgb(68,73,82);
}

QDialog#ApplyFriend QPushButton#cancel_button:hover
{
    background-color: rgb(216,219,225);
}

QDialog#ApplyFriend QPushButton#cancel_button:pressed
{
    background-color: rgb(228,230,234);
}

QLabel#tipslb[empty='true'],
QLabel#tipsLabel[empty='true']
{
    background-color: transparent;
    border: 1px dashed rgb(216,219,225);
    color: rgb(176,181,189);
}

QDialog#ApplyFriend QLabel#loading_label
{
    background-color: rgb(255,255,255);
    background-image: url(":/assets/images/loading.gif");
}

/* ==================== 好友标签胶囊 FriendLabel ==================== */

QFrame#friendLabel
{
    background-color: rgb(228,230,234);
    border-color: rgb(190,194,202);
}

QFrame#friendLabel:hover
{
    background-color: rgb(216,219,225);
    border-color: rgb(122,129,139);
}

QFrame#friendLabel QLabel#tip_label
{
    color: rgb(28,31,36);
}

QFrame#friendLabel QLabel#close_label[state='normal'],
QFrame#friendLabel QLabel#close_label[state='selected_normal']
{
    background-image: url(":/assets/images/themes/light/close.png");
}

QFrame#friendLabel QLabel#close_label[state='hover'],
QFrame#friendLabel QLabel#close_label[state='selected_hover']
{
    background-image: url(":/assets/images/themes/light/close_hover.png");
}

QFrame#friendLabel QLabel#close_label[state='pressed'],
QFrame#friendLabel QLabel#close_label[state='selected_pressed']
{
    background-image: url(":/assets/images/themes/light/close_push.png");
}
