/* ============================================================
   MyChat —— 浅色主题（themes/light.qss，QQ NT 浅色系）
   ------------------------------------------------------------
   色板（与 dark.qss 的选择器一一对应，改一处必须同步另一处）：

   背景色阶（浅色主题的层级靠「灰度下沉」表达，与白底拉开）：
   - 窗口背景    rgb(255,255,255)  登录/注册/重置对话框、主窗口
   - 侧栏背景    rgb(237,238,241)  side_bar
   - 面板背景    rgb(245,246,248)  列表区 / 聊天区 / 右区容器
   - 卡片背景    rgb(255,255,255)  浮层弹窗卡片（配强描边区分层级）
   - 控件背景    rgb(240,241,244)  输入框 / 次级按钮 / 标签区
   - 悬停        rgb(228,230,234)
   - 选中        rgb(216,219,225)  也用作胶囊底色
   - 描边强调    rgb(190,194,202)  胶囊描边 / 滚动条滑块悬停

   边框：
   - 分隔线      rgb(226,228,232)
   - 强描边      rgb(205,209,215)

   文字：
   - 主文字      rgb(28,31,36)     对比度（对面板）≈ 15.6:1
   - 次级文字    rgb(122,129,139)  ≈ 4.8:1（AA）
   - 禁用文字    rgb(176,181,189)

   强调（QQ 蓝，与深色主题同族）：
   - 强调        rgb(0,153,255)
   - 强调-悬停   rgb(38,166,255)
   - 强调-按下   rgb(0,122,204)
   - 强调-淡底   rgba(0,153,255,25) / rgba(0,153,255,55)
   - 强调-禁用   rgba(0,153,255,90) + 字 rgba(255,255,255,190)

   功能色：
   - 错误        rgb(214,69,69)
   - 成功        rgb(38,166,91)

   气泡：
   - 自己        rgb(0,153,255)（白字）
   - 对方        rgb(255,255,255)（主文字，灰底聊天区上的白气泡）

   图标：浅色主题字形在 :/assets/images/themes/light/ 下
        （深灰常态 / 蓝色悬停 / 深蓝按下），由 scripts 从原白色字形重着色。
   结构（圆角/尺寸/字体）见 ../common.qss。
   ============================================================ */

/* ==================== 全局基础 ==================== */

QDialog
{
    background-color: rgb(255,255,255);
    color: rgb(28,31,36);
}

QMainWindow
{
    background-color: rgb(255,255,255);
    color: rgb(28,31,36);
}

QToolTip
{
    background-color: rgb(255,255,255);
    color: rgb(28,31,36);
    border-color: rgb(205,209,215);
}

/* 菜单（输入框右键菜单等） */
QMenu
{
    background-color: rgb(255,255,255);
    color: rgb(28,31,36);
    border-color: rgb(205,209,215);
}

QMenu::item:selected
{
    background-color: rgb(228,230,234);
}

QMenu::item:disabled
{
    color: rgb(176,181,189);
}

QMenu::separator
{
    background-color: rgb(226,228,232);
}

/* ---- 滚动条滑块 ---- */

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal
{
    background: rgb(205,209,215);
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed
{
    background: rgb(176,181,189);
}

/* ---- 输入框 ---- */

QLineEdit
{
    background-color: rgb(240,241,244);
    border-color: rgb(240,241,244);
    color: rgb(28,31,36);
    selection-background-color: rgb(0,153,255);
    selection-color: white;
}

QLineEdit:hover
{
    border-color: rgb(205,209,215);
}

QLineEdit:focus
{
    border-color: rgb(0,153,255);
    background-color: rgb(255,255,255);
}

QLineEdit:disabled
{
    background-color: rgb(245,246,248);
    border-color: rgb(245,246,248);
    color: rgb(176,181,189);
}

/* ---- 按钮基础 ---- */

QPushButton
{
    background-color: rgb(240,241,244);
    color: rgb(28,31,36);
}

QPushButton:hover
{
    background-color: rgb(228,230,234);
}

QPushButton:pressed
{
    background-color: rgb(216,219,225);
}

QPushButton:disabled
{
    background-color: rgb(245,246,248);
    color: rgb(176,181,189);
}

/* ==================== 跨页面复用 ==================== */

QLabel#error_tip[state='normal'],
QLabel#err_tip[state='normal']
{
    color: rgb(38,166,91);
}

QLabel#error_tip[state='err'],
QLabel#err_tip[state='err']
{
    color: rgb(214,69,69);
}

/* 取消按钮：次级按钮（注册页、重置页共用） */
QPushButton#cancel_button
{
    background-color: rgb(240,241,244);
    color: rgb(68,73,82);
}

QPushButton#cancel_button:hover
{
    background-color: rgb(216,219,225);
}

QPushButton#cancel_button:pressed
{
    background-color: rgb(228,230,234);
}

