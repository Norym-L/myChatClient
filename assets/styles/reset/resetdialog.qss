/* ============================================================
   重置页 ResetDialogClass（reset/resetdialog.qss）
   错误提示复用 ../common.qss 中 #error_tip[state=...] 规则；
   取消按钮复用 ../common.qss 中 #cancel_button 规则。
   ============================================================ */

/* 获取验证码：蓝描边按钮（TimerButton 倒计时期间为 disabled）
   与注册页 get_token_button 同样式 */
QPushButton#get_verify_button
{
    background-color: transparent;
    border: 1px solid rgb(0,153,255);
    border-radius: 4px;
    color: rgb(0,153,255);
    padding: 2px 10px;
}

QPushButton#get_verify_button:hover
{
    background-color: rgba(0,153,255,40);
}

QPushButton#get_verify_button:pressed
{
    background-color: rgba(0,153,255,70);
}

QPushButton#get_verify_button:disabled
{
    border-color: rgb(61,61,61);
    background-color: transparent;
    color: rgb(120,120,120);
}

/* 确认：QQ 蓝主按钮 */
QPushButton#ok_button
{
    background-color: rgb(0,153,255);
    color: white;
}

QPushButton#ok_button:hover
{
    background-color: rgb(26,168,255);
}

QPushButton#ok_button:pressed
{
    background-color: rgb(0,122,204);
}

QPushButton#ok_button:disabled
{
    background-color: rgba(0,153,255,90);
    color: rgba(255,255,255,150);
}
